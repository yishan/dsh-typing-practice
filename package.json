{
  "name": "typing-practice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typing practice: a timed typing test in the DSH sidebar with live WPM and accuracy.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yishan/dsh-typing-practice.git"
  },
  "homepage": "https://github.com/yishan/dsh-typing-practice#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "typing",
    "typing-test"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  }
}
